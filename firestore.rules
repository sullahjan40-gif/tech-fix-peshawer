rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model & Architecture (TechFix Peshawar)
    // ===============================================================
    // - Services: Public published services list; admin CMS management
    // - FAQ: Public published FAQs; admin management
    // - Case Studies: Public portfolio items; admin management
    // - Settings: Public site config (site_config, website_content); admin-only private configs (admin)
    // - Bookings / ServiceRequests: Public submission & single ID status lookup; admin list/manage
    // - Inquiries / Contacts: Public submission; admin-only read/manage
    // - Customers: Admin-only private customer profiles
    // - Activity Logs: Admin-only audit trail (no public forgery)
    // - Users: Owner read/write profile with role immutability; admin full access
    // ===============================================================

    function isAuth() {
      return request.auth != null;
    }

    // Cryptographic token admin claim or authoritative admin email check (FR-001, FR-002, BUG-013, BUG-014)
    // Never depends on mutable user documents in Firestore.
    function isAdmin() {
      return isAuth() && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          'techfixpeshawar@gmail.com',
          'sullahjan40@gmail.com',
          'ullahsafiullah117@gmail.com',
          'admin@peshawar-techsupport.pk'
        ]
      );
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Safely check if a resource exists and is published/active (BUG-079)
    // Prevents rule crashes on non-existent documents or missing 'status' field
    function isPublishedResource() {
      return resource != null && 'status' in resource.data && resource.data.status in ['PUBLISHED', 'published', 'active'];
    }

    // ---------------------------------------------------------------
    // 1. Services Catalog (CMS) (BUG-079)
    // ---------------------------------------------------------------
    match /services/{serviceId} {
      allow read: if isPublishedResource() || isAdmin();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // 2. FAQ Items (CMS) (BUG-079)
    // ---------------------------------------------------------------
    match /faq/{faqId} {
      allow read: if isPublishedResource() || isAdmin();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // 3. Real Service Cases / Case Studies (CMS) (BUG-079)
    // ---------------------------------------------------------------
    match /caseStudies/{caseStudyId} {
      allow read: if isPublishedResource() || isAdmin();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // 4. Page Sections & Content (CMS)
    // ---------------------------------------------------------------
    match /page_sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /problemSolutions/{solutionId} {
      allow read: if isPublishedResource() || isAdmin();
      allow write: if isAdmin();
    }

    match /problemLeads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // 5. Site Settings (e.g. site_config, website_content) (BUG-017, BUG-035, BUG-080)
    // Public can only read public CMS configs ('site_config', 'website_content'); private configs (e.g. 'admin') require admin.
    // Writes strictly require admin and forbid storing sensitive server-side credentials/secrets.
    // ---------------------------------------------------------------
    match /settings/{settingId} {
      allow read: if settingId in ['site_config', 'website_content'] || isAdmin();
      allow write: if isAdmin() && 
        !('adminPassword' in request.resource.data) &&
        !('resendApiKey' in request.resource.data) &&
        !('gmailAppPassword' in request.resource.data) &&
        !('smtpPassword' in request.resource.data);
    }

    // ---------------------------------------------------------------
    // 6. Bookings & Service Requests (FR-004, FR-005, BUG-019)
    // Public can submit & look up a single known Reference ID; only admin can list or update
    // ---------------------------------------------------------------
    match /serviceRequests/{requestId} {
      allow create: if true;
      allow get: if true;
      allow list, update, delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow create: if true;
      allow get: if true;
      allow list, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if true;
      allow get: if true;
      allow list, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // 7. Customer Inquiries & Leads (FR-004, BUG-016, BUG-018, BUG-025)
    // Public can submit; only authenticated admin can list, read, or delete
    // ---------------------------------------------------------------
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // 8. Customers CRM Directory (BUG-016, BUG-021)
    // Strictly private customer profiles
    // ---------------------------------------------------------------
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // 9. Media Assets
    // ---------------------------------------------------------------
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // 10. Audit Activity Logs (BUG-081, BUG-083)
    // Admin-only audit trail; public cannot forge activity logs
    // ---------------------------------------------------------------
    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // 11. User Profiles & Role Protection (BUG-013, BUG-014)
    // Users can create/update their profile but CANNOT self-escalate role to admin
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (
        isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role != 'admin')
      );
      allow update: if isAdmin() || (
        isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }
  }
}
