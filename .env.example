# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Destination email for client booking and inquiry alerts (administrator inbox)
NOTIFICATION_TARGET_EMAIL=your-email@example.com
NOTIFICATION_EMAIL="ullahsafiullah117@gmail.com"

# Provider A: Resend API (via https://api.resend.com/emails)
RESEND_API_KEY=
RESEND_FROM="Peshawar Tech Support <onboarding@resend.dev>"

# Provider B: Nodemailer SMTP (Gmail 16-character App Password or Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER="ullahsafiullah117@gmail.com"
SMTP_PASS="nnaqtgoxvitvplf"
SMTP_FROM="TechFix Peshawar Support <ullahsafiullah117@gmail.com>"

# Gmail App Password convenience alias
GMAIL_USER="ullahsafiullah117@gmail.com"
GMAIL_APP_PASSWORD="nnaqtgoxvitvplf"
